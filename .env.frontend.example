# ====================================================
# FRONTEND CONFIGURATION (VITE)
# ====================================================

# Case 1: Unified Single Service Deployment on Render (Recommended)
# Leave VITE_API_URL empty so Frontend uses relative path (/api/*) to reach Express server.
VITE_API_URL=

# Case 2: Separate Frontend Deployment on Vercel / Netlify
# Set VITE_API_URL to your live Render backend URL:
# VITE_API_URL=https://personainsight-hrm301.onrender.com
